<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="mapsViewModel"
            type="com.kandaidea.mobilegis.ViewModel.MapsActivityViewModel"/>
    </data>
    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:fitsSystemWindows="true">

        <android.support.v4.widget.DrawerLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:openDrawer="start">
            <android.support.constraint.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <org.osmdroid.views.MapView
                    android:id="@+id/map_view_main"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                </org.osmdroid.views.MapView>

                <android.support.v7.widget.Toolbar
                    android:id="@+id/main_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    style="@style/actionbar_style"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="visible">
                    <android.support.constraint.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="right">
                        <ImageButton
                            android:id="@+id/search_item"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_search"
                            android:layout_marginRight="8dp"

                            android:scaleType="center"
                            android:scaleY=".6"
                            android:scaleX=".6"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:background="@android:color/transparent"
                            />
                        <ImageButton
                            android:id="@+id/screenshot_item"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_camera"
                            android:onClick="@{() -> mapsViewModel.takeScreenshot()}"
                            android:scaleType="center"
                            android:scaleY=".6"
                            android:scaleX=".6"
                            app:layout_constraintRight_toLeftOf="@+id/search_item"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:background="@android:color/transparent"
                            />
                        <ImageButton
                            android:id="@+id/map_item"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_map"
                            android:scaleType="center"
                            android:scaleY=".6"
                            android:scaleX=".6"
                            app:layout_constraintRight_toLeftOf="@+id/screenshot_item"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:background="@android:color/transparent"
                            />
                        <ImageView
                            android:id="@+id/company_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_company"
                            android:scaleType="center"
                            android:scaleY="1.5"
                            android:scaleX="1.5"
                            android:background="@android:color/transparent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toRightOf="@id/navigation_drawer"/>
                        <ImageButton
                            android:id="@+id/navigation_drawer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_navigation"
                            android:scaleType="center"
                            android:scaleY=".6"
                            android:scaleX=".6"
                            android:background="@android:color/transparent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"/>
                    </android.support.constraint.ConstraintLayout>

                </android.support.v7.widget.Toolbar>
                <android.support.v7.widget.Toolbar
                    android:id="@+id/direction_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/direction_toolbar_height"
                    android:background="@xml/direction_layer_item"
                    android:elevation="@dimen/action_bar_elevation"
                    android:layout_margin="@dimen/action_bar_margin"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="gone">
                    <android.support.constraint.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/direction_toolbar_height"
                        android:gravity="left"
                        android:foregroundGravity="left">
                        <ImageButton
                            android:id="@+id/back_arrow_direction_bar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_back_arrow"
                            android:background="@android:color/transparent"
                            android:scaleX=".8"
                            android:scaleY=".8"
                            android:scaleType="center"
                            android:gravity="left"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <TextView
                            android:id="@+id/source_point_text_view"
                            android:layout_width="200dp"
                            android:layout_height="25dp"
                            android:background="@xml/actionbar_layer_list"
                            android:hint="@string/source_point_text_hint"
                            android:layout_margin="@dimen/regular_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintLeft_toRightOf="@+id/back_arrow_direction_bar"/>
                        <TextView
                            android:id="@+id/destination_point_text_view"
                            android:layout_width="200dp"
                            android:layout_height="25dp"
                            android:background="@xml/actionbar_layer_list"
                            android:hint="@string/destination_point_text_hint"
                            android:layout_margin="@dimen/regular_margin"
                            app:layout_constraintTop_toBottomOf="@+id/source_point_text_view"
                            app:layout_constraintLeft_toRightOf="@+id/back_arrow_direction_bar"/>
                        <ImageButton
                            android:id="@+id/change_source_destination"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/ic_swap"
                            android:layout_margin="@dimen/regular_margin"
                            android:background="@android:color/transparent"
                            android:scaleType="fitStart"
                            android:scaleX=".8"
                            android:scaleY=".8"
                            app:layout_constraintBottom_toBottomOf="@+id/destination_point_text_view"
                            app:layout_constraintTop_toTopOf="@+id/source_point_text_view"
                            app:layout_constraintLeft_toRightOf="@+id/source_point_text_view"/>
                    </android.support.constraint.ConstraintLayout>

                </android.support.v7.widget.Toolbar>

                <TextView
                    android:id="@+id/draw_information"
                    android:layout_width="200dp"
                    android:layout_height="50dp"
                    android:visibility="gone"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="50dp"
                    android:gravity="center"
                    android:textColor="@android:color/black"
                    android:background="@xml/actionbar_layer_list"
                    android:elevation="@dimen/regular_elevation" />
                <ImageButton
                    android:id="@+id/my_location_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_my_location"
                    style="@style/mainButtonStyle"
                    android:onClick="@{() -> mapsViewModel.goMyLocation()}"
                    android:background="@drawable/round_button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent" />
                <ImageButton
                    android:id="@+id/zoom_out_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_zoom_out"
                    style="@style/mainButtonStyle"
                    android:onClick="@{(v) -> mapsViewModel.zoom(v)}"
                    android:layout_marginBottom="100dp"
                    android:background="@drawable/round_button"
                    app:layout_constraintBottom_toTopOf="@+id/my_location_button"
                    app:layout_constraintRight_toRightOf="parent"/>
                <ImageButton
                    android:id="@+id/zoom_in_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_zoom_in"
                    style="@style/mainButtonStyle"
                    android:onClick="@{(v) -> mapsViewModel.zoom(v)}"
                    android:background="@drawable/round_button"
                    app:layout_constraintBottom_toTopOf="@+id/zoom_out_button"
                    app:layout_constraintRight_toRightOf="parent"/>

                <TextView
                    android:id="@+id/speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/round_button"
                    android:textColor="@android:color/black"
                    android:layout_margin="@dimen/regular_margin"
                    android:gravity="center"
                    android:text="0.0"
                    app:layout_constraintBottom_toTopOf="@+id/zoom_in_button"
                    app:layout_constraintRight_toRightOf="parent"/>
                <include
                    android:id="@+id/detail_point_view_card"
                    layout="@layout/detail_point_view" />

                <include
                    android:id="@+id/map_settings_view_card"
                    layout="@layout/map_settings"/>

            </android.support.constraint.ConstraintLayout>
            <android.support.design.widget.NavigationView
                android:id="@+id/nav_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/navigation_background"
                app:headerLayout="@layout/nav_header_main"
                app:menu="@menu/activity_main_drawer"
                android:elevation="@dimen/navigation_drawer_elevation"
                />

        </android.support.v4.widget.DrawerLayout>
    </android.support.constraint.ConstraintLayout>
</layout>